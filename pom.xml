<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.opuadm.linuxifymc</groupId>
    <artifactId>LinuxifyMC</artifactId>
    <version>0.1.2</version>
    <packaging>jar</packaging>

    <name>LinuxifyMC</name>

    <properties>
        <java.version>21</java.version>
        <junit.version>6.1.3</junit.version>
        <jdk.toolchain.version>[25,)</jdk.toolchain.version>
        <maven.test.skip>true</maven.test.skip>
        <native.minecraft.version>26.2</native.minecraft.version>
        <paper.version>26.2.build.111-stable</paper.version>
        <plugin.api.version>26.2</plugin.api.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>select-jdk-toolchain</goal>
                        </goals>
                        <configuration>
                            <version>${jdk.toolchain.version}</version>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <proc>none</proc>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Specification-Version>${native.minecraft.version}</Specification-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/LICENSE</exclude>
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Specification-Version>${native.minecraft.version}</Specification-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>com.opuadm.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <classesDirectory>${project.build.directory}/test-runtime-classes</classesDirectory>
                    <systemPropertyVariables>
                        <linuxifymc.nativeMinecraftVersion>${native.minecraft.version}</linuxifymc.nativeMinecraftVersion>
                        <linuxifymc.version>${project.version}</linuxifymc.version>
                        <testPluginJar>${project.build.directory}/${project.build.finalName}-tests.jar</testPluginJar>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>test-plugin</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${maven.test.skip}</skip>
                            <target>
                                <mkdir dir="${project.build.directory}/test-runtime-classes" />
                                <jar destfile="${project.build.directory}/${project.build.finalName}-tests.jar">
                                    <manifest>
                                        <attribute name="Implementation-Version" value="${project.version}" />
                                        <attribute name="Specification-Version" value="${native.minecraft.version}" />
                                    </manifest>
                                    <fileset dir="${project.build.outputDirectory}" />
                                </jar>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.commons</groupId>
                    <artifactId>commons-lang3</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.plexus</groupId>
                    <artifactId>plexus-utils</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.codehaus.plexus</groupId>
            <artifactId>plexus-utils</artifactId>
            <version>3.6.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.53.2.1</version>
        </dependency>
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.2.1</version>
        </dependency>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.18.11</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>mockbukkit-1.18.2</id>
            <properties>
                <maven.test.skip>false</maven.test.skip>
                <paper.version>1.18.2-R0.1-SNAPSHOT</paper.version>
                <plugin.api.version>1.18</plugin.api.version>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.github.seeseemelk</groupId>
                    <artifactId>MockBukkit-v1.18</artifactId>
                    <version>2.85.2</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>mockbukkit-1.19.4</id>
            <properties>
                <maven.test.skip>false</maven.test.skip>
                <paper.version>1.19.4-R0.1-SNAPSHOT</paper.version>
                <plugin.api.version>1.19</plugin.api.version>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.github.seeseemelk</groupId>
                    <artifactId>MockBukkit-v1.19</artifactId>
                    <version>3.1.0</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>mockbukkit-1.20.6</id>
            <properties>
                <maven.test.skip>false</maven.test.skip>
                <paper.version>1.20.6-R0.1-SNAPSHOT</paper.version>
                <plugin.api.version>1.20</plugin.api.version>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.github.seeseemelk</groupId>
                    <artifactId>MockBukkit-v1.20</artifactId>
                    <version>3.93.2</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>mockbukkit-1.21.11</id>
            <properties>
                <maven.test.skip>false</maven.test.skip>
                <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
                <plugin.api.version>1.21</plugin.api.version>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.mockbukkit.mockbukkit</groupId>
                    <artifactId>mockbukkit-v1.21</artifactId>
                    <version>4.116.3</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>mockbukkit-26.1.2</id>
            <properties>
                <jdk.toolchain.version>[25,)</jdk.toolchain.version>
                <maven.test.skip>false</maven.test.skip>
                <paper.version>26.1.2.build.72-stable</paper.version>
                <plugin.api.version>26.1</plugin.api.version>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.mockbukkit.mockbukkit</groupId>
                    <artifactId>mockbukkit-v26.1.2</artifactId>
                    <version>4.115.0</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>mockbukkit-26.2</id>
            <properties>
                <jdk.toolchain.version>[25,)</jdk.toolchain.version>
                <maven.test.skip>false</maven.test.skip>
                <paper.version>26.2.build.111-stable</paper.version>
                <plugin.api.version>26.2</plugin.api.version>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.mockbukkit.mockbukkit</groupId>
                    <artifactId>mockbukkit-v26.2</artifactId>
                    <version>4.116.1</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
